{
  "name": "bro-oracle-server",
  "version": "1.0.0",
  "description": "On-demand BRO/USD price oracle: sends BROMarketAssistant.update_price when the on-chain price is old enough",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js"
  },
  "dependencies": {
    "@taquito/signer": "^25.1.0",
    "@taquito/taquito": "^25.1.0",
    "@taquito/utils": "^25.1.0",
    "cors": "^2.8.6",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
